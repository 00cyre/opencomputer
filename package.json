{
  "name": "@00cyre/opencomputer",
  "version": "0.4.4",
  "description": "App-scoped background computer use for macOS. JavaScript API and local MCP server.",
  "type": "module",
  "exports": "./src/computer.mjs",
  "bin": {
    "opencomputer": "./bin/opencomputer.mjs"
  },
  "files": [
    "bin",
    "src",
    "native",
    "scripts/build.sh",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "doctor": "node bin/opencomputer.mjs doctor",
    "fixture:build": "bash scripts/build-fixture.sh",
    "test:integration": "node tests/integration.mjs",
    "package": "bash scripts/package.sh",
    "test:activity": "node tests/activity.mjs",
    "test:focus": "node tests/focus-guard.mjs",
    "test:ui": "bash scripts/test-ui.sh",
    "test:motion": "bash scripts/test-motion.sh",
    "test:interaction": "bash scripts/test-interaction.sh",
    "test:guard": "node tests/target-guard.mjs",
    "test:perception": "node tests/perception.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/00cyre/opencomputer.git"
  }
}
